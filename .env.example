# ============================================================================
# .env.example — Mall Services / Cloudflare Pages
# ============================================================================
# هذا الملف توثيق + قالب فقط، ومفيش أي كود بيقراه تلقائياً.
# Cloudflare Pages بيقرا المتغيرات من: Dashboard → مشروعك → Settings →
# Environment Variables. بعد أي إضافة/تعديل لازم تعمل Redeploy عشان تتفعل.
#
# ⚠️ NEVER commit a real value of this file. انسخ القيم الحقيقية من Firebase /
#    بوابة الدفع وحطها في Cloudflare Dashboard، مش في المستودع.
#    (Cloudflare Pages بيقرأ من الـ dashboard، لكن لو رافع المشروع كـ Pages
#    Upload/Direct Upload فأي ملف .env جوه المجلد بيروح مع الكود.)
#
# راجع DEPLOY_CLOUDFLARE.md لق خطوات النشر، و AUDIT_REPORT.md لتقرير التدقيق.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# 1) Firebase — مطلوب (الخادم بيقرأ ويكتب في Firestore و Realtime Database)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ FIREBASE_PROJECT_ID لازم يكون "services-mall" بالظبط — وده من الـ
#    FIREBASE_CONFIG في index.html. دومين الموقع نفسه اسمه
#    mall-services.pages.dev (الكلمتين معكوستين!) وده أشهر غلطة في الإعداد:
#    بتتحط قيمة غلط فكل قراءة Firestore من السيرفر بترجع "not found" صامت،
#    رغم إن نفس المستند بيفتح كويس من المتصفح. اتأكد مرتين.
FIREBASE_PROJECT_ID=services-mall

# مفتاح الـ Web API بتاع Firebase (مش سر — هو نفس apiKey الظاهر في
# FIREBASE_CONFIG بالـ frontend). اختياري: لو اتساب، gcp.js بيستخدم قيمة
# افتراضية مدمجة. حطّه برضه لو عايز توحيد القيم.
FIREBASE_WEB_API_KEY=AIzaSyDfWKWN5CTlBA-krEMXsmYmaI8j7fyuw20

# ★★★ الأهم ★★★
# الـ JSON كامل لمفتاح service account، ملزوق في سطر واحد.
# Firebase Console → Project settings → Service accounts → Generate new private key
# بيفتح ملف .json → افتحه و انسخ كل محتواه (من { لحد }) في سطر واحد هنا.
# Security Note: المفتاح ده بيدي صلاح كاملة على Firestore/RTDB (لأنه بيشتغل
# كـ service account و بيتخطى Security Rules). متحطوش في أي frontend ولا في
# أي مستودع عام، وخليه مكتوب في متغيرات Cloudflare السرّية فقط.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"services-mall","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@services-mall.iam.gserviceaccount.com","client_id":"000000000000000000000","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# اختياري. لو سيبته فاضي، الكود بيبني الرابط تلقائياً على النمط
# https://<project-id>-default-rtdb.firebaseio.com وده فعلاً الـ URL بتاع مشروعك.
# حطّه صريح بس لو بتستخدم database instance تانية أو استضافة مختلفة.
FIREBASE_DATABASE_URL=https://services-mall-default-rtdb.firebaseio.com


# ─────────────────────────────────────────────────────────────────────────────
# 2) روابط الموقع
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ قيمة واحدة بس، من غير slash في الآخر:
#    صح:  https://mall-services.pages.dev
#    غلط: https://mall-services.pages.dev/     ← الـ slash جوّا الـ string
#    غلط: https://a.com,https://b.com          ← ده مش متغير SITE_URL
#    SITE_URL بيتبني عليه روابط البوابة (redirect/webhook) و sitemap.
SITE_URL=https://mall-services.pages.dev

# قائمة origins مسموح لها تتصل بالـ API، مفصولة بفاصلة (،) بدون مسافات.
# لازم تكون origin كاملة: https://mall-services.pages.dev
# لو عندك preview environments، ضيفهم بنفس الشكل:
#   https://mall-services.pages.dev,https://abc123.mall-services.pages.dev
# وممكن تضيف دومين مخصص لو ربطته.
# ⚠️ فرق مهم: SITE_URL = "أحطّ منه روابط" / ALLOWED_ORIGINS = "قائمة أتحقق منها".
#    متحطش قائمة origins في SITE_URL ولا دومين واحد في ALLOWED_ORIGINS.
ALLOWED_ORIGINS=https://mall-services.pages.dev

# لو ربطت دومين مخصص، ضيفه هنا كمان (لكن سيب SITE_URL على دومين أساسي واحد):
# ALLOWED_ORIGINS=https://mall-services.pages.dev,https://www.example.com


# ─────────────────────────────────────────────────────────────────────────────
# 3) حماية لوحة التحكم والـ API الإداري
# ─────────────────────────────────────────────────────────────────────────────
# مفتاح سري عشوائي طويل. من غيره، /api/ai-generate و /api/quality-score و
# /api/subscription بيرفضوا نداءات الـ cron كلها (401).
# ولّد واحد بالأمر ده (Node 18+):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠️ نفس القيمة بالظبط لازم تتكرر كـ secret في cron-worker
#    (npx wrangler secret put ADMIN_SECRET) — وإلا الجدولة اليومية تفشل.
ADMIN_SECRET=ضع-هنا-قيمة-عشوائية-طويلة-جداً-من-الأمر-أعلاه

# قائمة UIDs بتوع الأدمن، مفصولة بفاصلة. أي UID هنا يتفرج عليه كأدمن
# (role=='admin' في مستند users برضه شغال). هما اللي بيوصلوا لزرار
# "توليد مقال AI" ولوحات الأدمن.
# إزاي تلاقي الـ UID: سجّل دخول، افتح Firestore Console، collection users،
# المستند بتاعك — الـ uid هو الـ Document ID بتاعه.
# ⚠️ غلط شائع: مسح كده أي مستخدم عادي يقدر يولّد مقالات ويستهلك رصيد
#    Gemini/OpenAI. حطّ UID الأدمن الحقيقي بس.
ADMIN_UIDS=حط-uid-الأدمن-هنا-مفصول-بفاصلة-لو-في-أكتر


# ─────────────────────────────────────────────────────────────────────────────
# 4) بوابة الدفع — Fawaterak (الوحيدة المستخدمة فعلياً)
# ─────────────────────────────────────────────────────────────────────────────
# من لوحة Fawaterak Merchant. من غيره، create-intent بيرجع خطأ صريح
# (مش بيرجع تحويل وهمية).
FAWATERAK_API_KEY=

# اختياري — لو اتساب بيبقى https://app.fawaterk.com
FAWATERAK_BASE_URL=https://app.fawaterk.com

# ⚠️ Kashier لسه scaffold مش مفعّل. حطّ KASHIER_API_KEY بس لما تكمل
#    handleKashier() في functions/api/payment.js من توثيق لوحة التاجر —
#    دلوقتي لو حطّيت المفتاح، الـ endpoint بيرمي استثناء عن قصد عشان
#    ما يتحصّلش فلوس على أساس integration ناقص.
KASHIER_API_KEY=
# KASHIER_BASE_URL=      ← مستخدم لسه في كود مشغّل (تعليق) — سيبه فاضي

# ⚠️ خطر: ALLOW_SIMULATED_PAYMENTS=true بيخلي أي عملية دفع تتسجّل كأنها
#    نجحت من غير ما في بوابة ولا فلوس حقيقية — الطلب بيتحفظ كمدفوع
#    والـ escrow بيتصرف. حطّه true للتجربة على بيانات وهمية فقط، وخليه false
#    على production. القيمة لازم تكون حرفاً بحرف 'true'.
ALLOW_SIMULATED_PAYMENTS=false


# ─────────────────────────────────────────────────────────────────────────────
# 5) الذكاء الاصطناعي — توليد المقالات + AI Brief
# ─────────────────────────────────────────────────────────────────────────────
# Google AI Studio → Get API key. ده الأساسي: cron بيستخدمه لتوليد مقالات.
GEMINI_API_KEY=

# بديل لـ Gemini لو الأول فشل. اختياري، لكن لو الاتنين فاضيين
# /api/ai-generate بيرجع خطأ.
OPENAI_API_KEY=

# اختياري — صور المقالات من Unsplash. من غيره بيرجع placeholder.
# unsplash.com/developers → Access Key.
UNSPLASH_ACCESS_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# 6) Google Analytics
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ مش متغير بيئة في Cloudflare — عايزك تعرف مكانه بس:
#    القياس بيتقرا من FIREBASE_CONFIG.measurementId في index.html
#    (سطر ~1587)، والقيمة مضبوطة فعلاً: G-20SMHQMQ1G
#    يعني الـ GA4 شغّال من غير أي خطوة إضافية. لو عايز تغيّر property،
#    غيّر measurementId في FIREBASE_CONFIG بس.
GA_MEASUREMENT_ID=G-20SMHQMQ1G


# ============================================================================
# ملاحظات مهمة
# ============================================================================
#
# أ) إعدادات Firebase العميلة (apiKey / authDomain / projectId / storageBucket /
#    messagingSenderId / appId / databaseURL) — دي مش متغيرات بيئة!
#    هي مكتوبة جوه كود index.html في الكائن FIREBASE_CONFIG (سطر ~1579)
#    لأن المتصفح لازم يقراها وقت الـ build. والد满是 هنا عشان ما تقراش
#    من الملف ده وتفتكر إنها متغيرات Cloudflare ناقصة.
#
# ب) المتغيرات دي مش مستخدمة (مذكورة في ملفات المشروع بس في تعليقات):
#    FIREBASE_ACCESS_TOKEN — كان الخطأ القديم في ai-generate.js (متغير
#      ماكانش متظبط أبداً، فكل كتابة مقال كانت بترفضها الـ rules بصمت).
#      اتشال بالكامل؛ الحين بيستخدم service account زي كل الـ functions التانية.
#    FIREBASE_API_KEY — مستخدم في seed-blog.js بس (سكربت Node محلي
#      للبذر، مش function).
#
# ج) بعد ما تضيف المتغيرات: Wrangler CLI → npx wrangler pages deploy .
#    أو من الـ dashboard: Redeploy.
#
# د) الـ Security Rules (firestore.rules / database.rules.json) مش
#    بينشرهم Cloudflare Pages — لازم deploy يدوي:
#    firebase deploy --only firestore:rules,database
#    (راجع DEPLOY_RULES.md و database.rules.notes.md)
# ============================================================================
