# ── Cloudflare Pages Environment Variables ────────────────────────────────────
# Set these in: Cloudflare dashboard → Pages project → Settings → Environment
# variables (add each one for BOTH "Production" and "Preview" if you use
# preview deployments). Anything used by functions/api/*.js must be set here —
# these are server-side only and never shipped to the browser.

# Firebase Config (required — also duplicated as plain constants in
# index.html since the client SDK needs its own public config; that part is
# fine to be public, it's not a secret)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Your live site's exact origin — used to build Fawaterak redirect/webhook
# URLs and for the CORS allow-list on every /api/* function. No trailing slash.
# Comma-separate multiple origins if you use a custom domain + the .pages.dev
# one at the same time (e.g. "https://mallservices.com,https://mall-services.pages.dev").
SITE_URL=https://mall-services.pages.dev
ALLOWED_ORIGINS=https://mall-services.pages.dev

# ── Fawaterak (the ONLY payment gateway) ──────────────────────────────────────
# Dashboard → Integrations → Generate/Get API Key
FAWATERAK_API_KEY=your_fawaterak_api_key
# Leave unset for production (defaults to https://app.fawaterk.com).
# Use https://staging.fawaterk.com while testing with their test cards.
FAWATERAK_BASE_URL=

# ── Kashier (⚠️ SCAFFOLD — see functions/api/payment.js handleKashier()) ─────
# Left unset = demo mode (real orders still work, just no real charge).
# Only set this once handleKashier() and kashier-webhook.js have been filled
# in with Kashier's real API details from their merchant dashboard docs.
KASHIER_API_KEY=
KASHIER_BASE_URL=

# Without these, the server cannot verify who's paying, look up real prices,
# or write the paid order — payments will fail with a clear error instead of
# silently trusting the browser.
# 1. Firebase Console → Project settings → Service accounts → Generate new
#    private key → paste the ENTIRE downloaded JSON file as ONE LINE here.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# 2. Optional — defaults to the public apiKey already in index.html.
FIREBASE_WEB_API_KEY=your_firebase_api_key

# AI Article Generation + AI Brief Generator (Gemini is tried first, OpenAI
# is the fallback — at least one is required)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
# Optional — cover images for AI-generated blog posts. Without it, a fixed
# fallback image is used instead (functions/api/ai-generate.js).
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Admin Security (HIGHLY RECOMMENDED — protects the AI generation and
# quality-score/subscription-billing cron endpoints)
# Option A: a strong random secret, used by cron-worker's scheduled calls
ADMIN_SECRET=your_random_secret_string_here
# Option B: comma-separated Firebase UIDs allowed to trigger AI generation
# from the admin dashboard button directly (no shared secret needed there)
ADMIN_UIDS=uid1_here,uid2_here
