rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn()  { return request.auth != null; }
    function isOwner(uid)  { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin()     {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isSeller()    {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['seller','admin'];
    }
    function isSellerOwner(sellerId) {
      return isSignedIn() && request.auth.uid == sellerId;
    }
    // Set ONLY by functions/_shared/trust.js after repeated disputes ruled against the seller.
    function sellerBlocked() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/trust/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/trust/$(request.auth.uid)).data.get('sellerBlocked', false) == true;
    }
    function _order(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(userId)
                    && (!('role' in request.resource.data) || request.resource.data.role in ['buyer','seller']);
      // ⚠️ CHANGED (privacy audit): 'phone' removed from the editable-fields
      // list. This document is readable by ANY signed-in user (needed so
      // buyers can see a seller's public name/avatar/bio/rating) — there is
      // no such thing as a "partial" Firestore rule that opens some fields
      // to everyone and others to nobody, security rules only ever see the
      // whole document. So anything that shouldn't be readable by every
      // other logged-in user (phone number; payoutMethod/payoutAccount were
      // already never in this list) now lives in the private subcollection
      // just below instead, not here. See js/auth.js (_ensureUserDoc,
      // register, updateProfile) and js/seller-dashboard.js
      // (savePayoutInfo) for the corresponding client-side change, and
      // functions/api/admin-migrate-private-fields.js for the one-time
      // migration of any pre-existing users' data out of this document.
      allow update: if isAdmin() || (
                      isOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['name','displayName','avatar','photoURL','bio',
                                  'role','updatedAt','acceptedTerms','termsAcceptedAt']) &&
                      (!('role' in request.resource.data.diff(resource.data).affectedKeys()) ||
                       (resource.data.role == 'buyer' && request.resource.data.role == 'seller'))
                    );
      allow delete: if isAdmin();

      // ── users/{uid}/private/{contact} ─────────────────────────────────────
      // ⚠️ ADDED: phone number + payout method/account — readable only by the
      // account owner and admins, never by "any signed-in user" the way the
      // parent document above is. A single fixed-id doc ('contact') rather
      // than one per field, since these are always read/written together.
      match /private/{docId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAdmin());
      }
    }

    // ── services ──────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      // ⚠️ FIXED: create used to accept ANY values for trust fields, so a seller
      // could publish a listing already showing rating 5.0 / 999 reviews /
      // featured / verified straight from the browser console. They must now
      // start at their neutral defaults (js/services.js already sends exactly
      // these); the server/admin changes them later.
      allow create: if isSeller() && !sellerBlocked()
                    && serviceId.matches('[A-Za-z0-9_-]{1,64}')
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.keys().hasAll(['title','price','sellerId','createdAt'])
                    && request.resource.data.price is number && request.resource.data.price > 0
                    && request.resource.data.get('rating', 0) == 0
                    && request.resource.data.get('reviewCount', 0) == 0
                    && request.resource.data.get('orderCount', 0) == 0
                    && request.resource.data.get('ordersCount', 0) == 0
                    && request.resource.data.get('featured', false) == false
                    && request.resource.data.get('sellerVerified', false) == false
                    // dropship listings are created ONLY by functions/api/dropship.js (importProduct)
                    && request.resource.data.get('dropship', false) == false
                    && !('supplierProductId' in request.resource.data)
                    && !('supplierId' in request.resource.data);
      allow update: if isAdmin() || (
                      isSellerOwner(resource.data.sellerId) && isSeller() && !sellerBlocked() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['title','description','category','price','deliveryDays',
                                  'revisions','image','images','tags','active','status','recurring','updatedAt',
                                  'listingType','digitalDelivery','stockLimit','expiryDate',
                                  'orderMode','orderRules','structuredFields','shippingFee','shippingMode','storeId',
                                  'sellerName','sellerAvatar'])
                      && request.resource.data.price is number && request.resource.data.price > 0
                      // a dropship listing can never be priced below wholesale + minimum margin (floor kept in sync by the server)
                      && (!resource.data.get('dropship', false) || request.resource.data.price >= resource.data.get('dropshipFloorPrice', 0))
                    );
      allow delete: if isSellerOwner(resource.data.sellerId) || isAdmin();
    }

    // ── orders ────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      // Products skip approval (buyProductNow), and "instant" order-mode
      // services (openInstantModal → submitRequest) also start at 'accepted'
      // so payment can begin right away — everything else must start 'pending'.
      // ⚠️ SECURITY FIX (audit finding): price/sellerId used to be taken
      // straight from the client's write with no cross-check at all — a
      // buyer's own browser is what writes this document, so nothing stopped
      // it from naming a real service's serviceId while setting sellerId to
      // an account the buyer controls, or a price far from the service's
      // real one. The actual money was always safe (functions/api/payment.js
      // re-resolves both from the service doc itself before ever charging or
      // crediting anyone — see resolveExistingOrder()'s comments there for
      // the one path that had drifted from that and has since been fixed
      // too), but the order document itself — what the seller and the admin
      // panel display and reason about before payment — could still show a
      // spoofed seller/price. Requiring it to match the live service doc at
      // write time closes that gap at the source as well, not just at the
      // one endpoint that touches money.
      // Doc ids are interpolated into onclick="openWorkspace('<id>')" handlers
      // all over the UI — a client-chosen id containing a quote was an XSS
      // vector against the seller/admin. Legit ids (ord_…, auto-ids) always fit.
      allow create: if isSignedIn()
                    && orderId.matches('[A-Za-z0-9_-]{1,64}')
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.sellerId != request.auth.uid
                    && request.resource.data.paymentStatus == 'no_payment'
                    && (!('escrowHeld' in request.resource.data) || request.resource.data.escrowHeld != true)
                    && !('dropship' in request.resource.data) && !('supplierId' in request.resource.data)
                    && !('trackingNumber' in request.resource.data) && !('carrier' in request.resource.data)
                    && (
                         !('serviceId' in request.resource.data) ||
                         (
                           request.resource.data.sellerId == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.sellerId &&
                           request.resource.data.price    == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.price
                         )
                       )
                    && (
                         request.resource.data.status == 'pending'
                         || (request.resource.data.status == 'accepted' &&
                             (request.resource.data.listingType == 'product' ||
                              request.resource.data.orderMode == 'instant'))
                       );
      allow update: if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId  ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin()) &&
                       (isAdmin() || (
                         // ⚠️ SECURITY FIX (critical): the old check only froze
                         // escrowHeld/escrowAmount/paymentId when they ALREADY
                         // existed on the doc — on an unpaid order they don't, so
                         // a buyer could add escrowHeld:true + paymentStatus:'paid'
                         // + status:'payment_held' from the browser console and the
                         // seller would see a "paid" order and deliver for free.
                         // Every payment field is now immutable for buyer/seller
                         // (get(..., null) treats "absent" as a value too), and the
                         // status can only move along legitimate client edges.
                         // 'payment_held', 'completed', 'refunded' are written ONLY
                         // by functions/api/payment.js (service account bypasses
                         // rules), so they can never be forged from here.
                         request.resource.data.get('paymentStatus', null) == resource.data.get('paymentStatus', null) &&
                         request.resource.data.get('escrowHeld', null)    == resource.data.get('escrowHeld', null) &&
                         request.resource.data.get('escrowAmount', null)  == resource.data.get('escrowAmount', null) &&
                         request.resource.data.get('escrowReleased', null) == resource.data.get('escrowReleased', null) &&
                         request.resource.data.get('paymentId', null)     == resource.data.get('paymentId', null) &&
                         request.resource.data.get('paymentMethod', null) == resource.data.get('paymentMethod', null) &&
                         request.resource.data.get('merchantOrderId', null) == resource.data.get('merchantOrderId', null) &&
                         request.resource.data.get('digitalDelivery', null) == resource.data.get('digitalDelivery', null) &&
                         request.resource.data.get('serviceId', null)     == resource.data.get('serviceId', null) &&
                         // dropshipping: marker/supplier/tracking are written by the server only
                         request.resource.data.get('dropship', null)      == resource.data.get('dropship', null) &&
                         request.resource.data.get('supplierId', null)    == resource.data.get('supplierId', null) &&
                         request.resource.data.get('supplierName', null)  == resource.data.get('supplierName', null) &&
                         request.resource.data.get('shippingFee', null)   == resource.data.get('shippingFee', null) &&
                         request.resource.data.get('shippingMode', null)  == resource.data.get('shippingMode', null) &&
                         request.resource.data.get('codAmount', null)     == resource.data.get('codAmount', null) &&
                         request.resource.data.get('trackingNumber', null) == resource.data.get('trackingNumber', null) &&
                         request.resource.data.get('carrier', null)       == resource.data.get('carrier', null) &&
                         (!resource.data.get('dropship', false) || (
                           request.resource.data.get('shippingStatus', null) == resource.data.get('shippingStatus', null) &&
                           request.resource.data.get('shippedAt', null)      == resource.data.get('shippedAt', null) &&
                           request.resource.data.get('deliveredAt', null)    == resource.data.get('deliveredAt', null)
                         )) &&
                         request.resource.data.price == resource.data.price &&
                         request.resource.data.buyerId == resource.data.buyerId &&
                         request.resource.data.sellerId == resource.data.sellerId &&
                         (
                           request.resource.data.status == resource.data.status ||
                           // seller answers a request (or buyer withdraws it)
                           (resource.data.status == 'pending' &&
                            request.resource.data.status in ['accepted','cancelled']) ||
                           // buyer sends brief after payment; revision loop
                           (resource.data.status in ['payment_held','revision'] &&
                            request.resource.data.status == 'in_progress') ||
                           // seller delivers — only ever on a paid order
                           (resource.data.status in ['payment_held','in_progress','revision'] &&
                            resource.data.get('escrowHeld', false) == true &&
                            resource.data.get('dropship', false) == false &&
                            request.resource.data.status == 'delivered' &&
                            // STRICT: a physical product can only be marked delivered after it was shipped WITH a tracking number
                            // (the tracking fields are written by /api/disputes markShipped only)
                            (resource.data.get('listingType', '') != 'product' || resource.data.get('shippingInfo', null) == null ||
                             (resource.data.get('shippingStatus', '') == 'shipped' && resource.data.get('trackingNumber', '') != ''))) ||
                           // buyer asks for changes
                           (resource.data.status in ['payment_held','in_progress','delivered'] &&
                            resource.data.get('escrowHeld', false) == true &&
                            request.resource.data.status == 'revision') ||
                           // either side opens a dispute (escrow.js / returns.js)
                           (resource.data.status in ['payment_held','in_progress','revision','delivered'] &&
                            resource.data.get('escrowHeld', false) == true &&
                            request.resource.data.status == 'disputed' &&
                            // a DELIVERED physical product is disputed ONLY through /api/disputes (evidence, one report, deadlines)
                            !(resource.data.status == 'delivered' && resource.data.get('listingType', '') == 'product' &&
                              resource.data.get('shippingInfo', null) != null))
                         )
                       ));
      allow delete: if isAdmin();
    }

    // ── payments ──────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.userId ||
                        request.auth.uid == resource.data.sellerId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── wallets ───────────────────────────────────────────────────────────────
    // ⚠️ FIXED: js/auth.js creates users/{uid}, users/{uid}/private/contact AND
    // wallets/{uid} in ONE batch at signup. With `write: if isAdmin()` the
    // wallet write was always denied, and a denied write fails the WHOLE batch
    // — so the user doc was never created either. A user may now create ONLY
    // their own wallet, with balance exactly 0 and no extra fields. Every
    // later change (credit/debit) stays admin/service-account only.
    match /wallets/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.balance == 0
                    && request.resource.data.keys().hasOnly(['balance','currency','createdAt']);
      allow update, delete: if isAdmin();
    }
    // ── transactions ──────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.userId || isAdmin());
      allow write:  if isAdmin();
    }
    // ── escrow ────────────────────────────────────────────────────────────────
    match /escrow/{orderId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      allow create: if false;
      allow update: if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId) &&
                       resource.data.status == 'held' &&
                       request.resource.data.status == 'frozen' &&
                       request.resource.data.amount   == resource.data.amount &&
                       request.resource.data.buyerId  == resource.data.buyerId &&
                       request.resource.data.sellerId == resource.data.sellerId
                    || isAdmin();
      allow delete: if isAdmin();
    }
    // ── withdrawals ───────────────────────────────────────────────────────────
    // ⚠️ SECURITY FIX (audit finding — critical): this used to allow ANY
    // signed-in user to create a withdrawals doc directly (only checking
    // `userId == auth.uid`), with no check on `amount` against their real
    // wallet balance at all. The real request flow (js/dashboard.js
    // submitWithdrawal → POST /api/payment `requestWithdrawal`) never uses
    // this client path — it goes entirely through functions/api/payment.js's
    // handleRequestWithdrawal, which verifies the balance server-side and
    // atomically debits the wallet using the service account (which bypasses
    // these rules by design, the same way escrow/wallets writes do). So a
    // client `create` here was never legitimate, only exploitable: someone
    // could hand-write a fake request for any amount with NO matching debit
    // ever having happened, have it sit in the admin's queue looking
    // identical to a real one, and if an admin clicked "✕ Reject" on it —
    // WalletManager.rejectWithdrawal() credits the wallet back by that exact
    // amount to undo a debit that, for a forged request, never occurred —
    // manufacturing real spendable balance out of nothing. Blocking client
    // `create` entirely closes this at the source; js/dashboard.js's
    // approve/reject actions were also hardened to check `status=='pending'`
    // first as defense in depth against double-processing.
    match /withdrawals/{reqId} {
      allow read:   if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ── reviews ───────────────────────────────────────────────────────────────
    // ⚠️ SECURITY FIX (audit finding): create used to only check
    // `reviewerId == auth.uid` — nothing tied the review to a real completed
    // order at all. Any signed-in user (a competitor, a seller reviewing
    // their own service from a second account, anyone) could post a review
    // for any seller/service with any rating, with no order ever having
    // happened — directly corrupting the rating shown to buyers and the
    // seller "quality score" functions/api/quality-score.js computes from
    // this same collection. Now a review can only be created by the actual
    // buyer of a real, COMPLETED order for that exact seller+service, and
    // only once per order (orders.reviewed flips to true in the same batch
    // that creates the review — see js/order-workspace.js submitReview —
    // so a second attempt sees reviewed==true and is rejected).
    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if isSignedIn()
                    && reviewId.matches('[A-Za-z0-9_-]{1,64}')
                    && request.resource.data.reviewerId == request.auth.uid
                    && request.resource.data.orderId is string
                    && _order(request.resource.data.orderId).buyerId    == request.auth.uid
                    && _order(request.resource.data.orderId).sellerId   == request.resource.data.sellerId
                    && _order(request.resource.data.orderId).serviceId  == request.resource.data.serviceId
                    && _order(request.resource.data.orderId).status     == 'completed'
                    && _order(request.resource.data.orderId).reviewed   != true;
      allow update: if isAdmin() || (
                      isOwner(resource.data.reviewerId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','text','updatedAt']) &&
                      request.resource.data.sellerId  == resource.data.sellerId &&
                      request.resource.data.serviceId == resource.data.serviceId &&
                      request.resource.data.orderId   == resource.data.orderId
                    );
      allow delete: if isOwner(resource.data.reviewerId) || isAdmin();
    }

    // ── articles / blog_posts ─────────────────────────────────────────────────
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── analytics ─────────────────────────────────────────────────────────────
    match /analytics/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
                       (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── subscriptions ─────────────────────────────────────────────────────────
    match /subscriptions/{subId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      allow write:  if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // Per-type allow-list of every legitimate cross-user notification the app
    // actually creates client-side:
    //   'new_request'/'new_order'   buyer  -> seller  (request-system.js)
    //   'request_accepted'          seller -> buyer   (order-workspace.js)
    //   'payment_reminder'          seller -> buyer   (seller-dashboard.js)
    //   'delivery'                  seller -> buyer   (order-workspace.js)
    //   'buyer_instructions'        buyer  -> seller  (order-workspace.js)
    //   'stage_update'              seller -> buyer   (order-workspace.js)
    //   'dispute'                   buyer/seller -> 'ADMIN' (escrow.js)
    // Anything else (payment_confirmed, withdrawal_paid, etc.) requires
    // isAdmin(), i.e. only the server's service-account writes.
    match /notifications/{notifId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() && notifId.matches('[A-Za-z0-9_-]{1,64}') && request.resource.data.orderId is string && (
          ((request.resource.data.type == 'new_request' || request.resource.data.type == 'new_order') &&
           request.auth.uid == _order(request.resource.data.orderId).buyerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).sellerId) ||
          ((request.resource.data.type == 'request_accepted' || request.resource.data.type == 'payment_reminder' ||
            request.resource.data.type == 'delivery' || request.resource.data.type == 'stage_update') &&
           request.auth.uid == _order(request.resource.data.orderId).sellerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).buyerId) ||
          (request.resource.data.type == 'buyer_instructions' &&
           request.auth.uid == _order(request.resource.data.orderId).buyerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).sellerId) ||
          ((request.resource.data.type == 'dispute' || request.resource.data.type == 'return_manual_refund' || request.resource.data.type == 'user_report') &&
           request.resource.data.userId == 'ADMIN' &&
           (request.auth.uid == _order(request.resource.data.orderId).buyerId ||
            request.auth.uid == _order(request.resource.data.orderId).sellerId)) ||
          // ── Product returns (js/returns.js) ─────────────────────────────
          (request.resource.data.type == 'return_requested' &&
           request.auth.uid == _order(request.resource.data.orderId).buyerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).sellerId) ||
          ((request.resource.data.type == 'return_approved' || request.resource.data.type == 'return_rejected') &&
           request.auth.uid == _order(request.resource.data.orderId).sellerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).buyerId)
        )
      );
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── chats / messages (legacy Firestore — real chat lives in RTDB now) ────
    match /chats/{chatId} {
      allow read, write: if isSignedIn() &&
                            (request.auth.uid in resource.data.participants || isAdmin());
      match /messages/{msgId} {
        allow read, write: if false;
      }
    }
    match /messages/{msgId} {
      allow read, write: if false;
    }

    // ── coupons ───────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── disputes ──────────────────────────────────────────────────────────────
    match /disputes/{disputeId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId  ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      allow create: if isSignedIn() && disputeId.matches('[A-Za-z0-9_-]{1,64}') &&
                       (request.resource.data.buyerId == request.auth.uid ||
                        request.resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── returns (product-return requests: buyer → seller → admin refund) ───────
    // Mirrors the /disputes pattern above: buyer creates, only the seller on
    // that order (or admin) can move it forward, and only while it's still
    // 'pending' (a decided return can't be flipped back by the seller).
    match /returns/{returnId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      allow create: if isSignedIn() && returnId.matches('[A-Za-z0-9_-]{1,64}') &&
                       request.resource.data.buyerId  == request.auth.uid &&
                       request.resource.data.status   == 'pending' &&
                       request.resource.data.keys().hasAll(['orderId','buyerId','sellerId','reasonCode','status','createdAt']) &&
                       // no returns once the buyer confirmed receipt: the order is 'completed' and the money has left escrow
                       get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'delivered';
      allow update: if isAdmin() || (
                       isSignedIn() &&
                       request.auth.uid == resource.data.sellerId &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status in ['approved','rejected'] &&
                       request.resource.data.orderId  == resource.data.orderId &&
                       request.resource.data.buyerId  == resource.data.buyerId &&
                       request.resource.data.sellerId == resource.data.sellerId
                     );
      allow delete: if isAdmin();
    }

    // ── service_views counter ─────────────────────────────────────────────────
    // ⚠️ SECURITY FIX (audit finding): `create: if true` let literally
    // anyone — including a signed-out visitor — write unlimited documents
    // here for free, with no shape or rate check at all: a pure storage/
    // quota-abuse (denial-of-wallet) vector. Grepping the whole app, nothing
    // in js/ or functions/ actually reads or writes this collection any
    // more (it appears to be leftover from a view-counter feature that was
    // never wired up, or was removed) — closing it to admin-only rather
    // than trying to validate a shape nothing currently produces.
    match /service_views/{viewId} {
      allow read, write: if isAdmin();
    }

    // ── categories ────────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn() && reportId.matches('[A-Za-z0-9_-]{1,64}') && request.resource.data.reportedBy == request.auth.uid;
    }

    // ── fraud_flags ───────────────────────────────────────────────────────────
    match /fraud_flags/{flagId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn() && flagId.matches('[A-Za-z0-9_-]{1,64}') && request.resource.data.userId == request.auth.uid;
    }

    // ── settings ──────────────────────────────────────────────────────────────
    // ⚠️ FIXED (found in audit): read used to require isSignedIn(), but
    // loadPlatformSettings() in constants.js runs at app start BEFORE
    // Firebase Auth has resolved (even for a logged-in user auth.uid can
    // still be null at that exact moment — a timing race, not a real
    // permission problem), and guests browsing services before logging in
    // also need the real commission % to see accurate pricing. This
    // document only holds public config (fee %, feature toggles) — never
    // secrets — so making it world-readable is safe; only admins can still
    // write it.
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── category_requests (seller suggests a category → admin reviews) ───────
    // ⚠️ ADDED: js/services.js writes here and the admin "categories" tab reads
    // it inside a Promise.all — with NO rule, Firestore denied every access
    // (even the admin's), so suggestions silently vanished AND the whole admin
    // categories tab failed to load.
    match /category_requests/{reqId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSeller()
                    && reqId.matches('[A-Za-z0-9_-]{1,64}')
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100;
    }

    // ── newsletter_subscribers (homepage + blog sign-up forms) ──────────────
    // ⚠️ ADDED: was written by index.html / blog-engine.js with no rule at all,
    // so every subscription was silently dropped. Public create (visitors are
    // signed out) but shape-checked so it can't be used as free storage.
    match /newsletter_subscribers/{subId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email','createdAt','source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
                    && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 40));
    }

    // ── pending_payments (server-only) ───────────────────────────────────────
    match /pending_payments/{id} {
      allow read, write: if false;
    }

    // ── Dropshipping (all WRITES go through functions/api/dropship.js + payment.js) ──
    // suppliers/{uid}: a supplier profile. Readable by signed-in users (name shown on listings).
    match /suppliers/{uid} {
      allow read:  if isSignedIn();
      allow write: if false;
    }
    // supplier_products/{id}: the wholesale CATALOGUE. Holds the cost price, so it is readable
    // only by sellers (resellers need it) and admins — never by plain buyers.
    match /supplier_products/{id} {
      allow read:  if isSeller();
      allow write: if false;
    }
    // dropship_orders/{orderId}: what the supplier must ship (carries the buyer's shipping
    // details). Readable only by the supplier, the reseller and admins.
    match /dropship_orders/{orderId} {
      allow read:  if isSignedIn() && (request.auth.uid == resource.data.supplierId ||
                                       request.auth.uid == resource.data.resellerId || isAdmin());
      allow write: if false;
    }

    // ── ad_placements (admin-managed: where ads may appear, price list, slots) ─
    // Visitors never read this directly — they get the enabled subset through
    // GET /api/ads-feed. Only the admin panel reads/writes the raw docs.
    match /ad_placements/{key} {
      allow read, write: if isAdmin();
    }

    // ── ads (a seller's ad request / running ad) ──────────────────────────────
    // Sellers can READ their own ads (dashboard list) but never write: status,
    // paid, startAt/endAt are all set by functions/api/ads.js, so a seller can
    // not approve/extend/mark-paid their own ad from the browser.
    match /ads/{adId} {
      allow read:  if isSignedIn() && (request.auth.uid == resource.data.sellerId || isAdmin());
      allow write: if false;
    }

    // ── rate_limits (server-only) ─────────────────────────────────────────────
    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // ── admin_actions (audit log — server-write only via admin-delete.js) ───
    match /admin_actions/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }


    // ── trust (dispute record per user) — written ONLY by the server ───────────
    match /trust/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isAdmin();    // admin can lift a block; clients can never write
    }

    // ── stores: one per seller, doc id == seller uid ───────────────────────────
    // The seller edits the storefront fields only. featuredUntil / planId / planName / planRank / verified / rating
    // are written by functions/api/stores.js (service account) or the admin.
    match /stores/{storeId} {
      allow read: if true;
      // A seller may own up to 5 stores: ids are  <uid>  (first store)  and  <uid>_2 … <uid>_5.
      allow create: if isSeller() && !sellerBlocked()
                    && (storeId == request.auth.uid || storeId.matches(request.auth.uid + '_[2-5]'))
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['ownerId','name','description','logo','banner','tagline','themeColor','layout','announcement','shippingPolicy','returnPolicy','country','city','status','createdAt','updatedAt'])
                    && request.resource.data.keys().hasAll(['ownerId','name','createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
                    && request.resource.data.get('status', 'active') in ['active','paused']
                    && request.resource.data.get('layout', 'grid3') in ['grid3','grid4','list']
                    && (!('themeColor' in request.resource.data) || request.resource.data.themeColor.matches('^#[0-9a-fA-F]{6}$'));
      allow update: if isAdmin() || (
                      isSellerOwner(resource.data.ownerId) && isSeller() && !sellerBlocked()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['name','description','logo','banner','tagline','themeColor','layout','announcement','shippingPolicy','returnPolicy','country','city','status','updatedAt'])
                      && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
                      && request.resource.data.get('status', 'active') in ['active','paused']
                      && request.resource.data.get('layout', 'grid3') in ['grid3','grid4','list']
                      && (!('themeColor' in request.resource.data) || request.resource.data.themeColor.matches('^#[0-9a-fA-F]{6}$')));
      allow delete: if isAdmin() || isSellerOwner(resource.data.ownerId);
    }
    // ── store packages (admin-defined) ────────────────────────────────────────
    match /store_plans/{planId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    // ── a seller's purchase of a package — server-written ────────────────────
    match /store_subscriptions/{subId} {
      allow read:  if isSignedIn() && (request.auth.uid == resource.data.sellerId || isAdmin());
      allow write: if false;
    }
  }
}
