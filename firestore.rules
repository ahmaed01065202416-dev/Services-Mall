rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn()  { return request.auth != null; }
    function isOwner(uid)  { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin()     {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isSeller()    {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['seller','admin'];
    }
    function isSellerOwner(sellerId) {
      return isSignedIn() && request.auth.uid == sellerId;
    }
    function _order(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }
    // A view counter bump: the ONLY non-admin write allowed on an article.
    // Exactly one field changes, it must be an integer, and it must be the
    // previous value plus one — so it cannot be used to rewrite an article or
    // to jump the count by an arbitrary amount. (Clients should use
    // FieldValue.increment(1), which the SDK sends as such an update.)
    function _isViewBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
             && request.resource.data.views is int
             && (!('views' in resource.data) || request.resource.data.views == resource.data.views + 1);
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // ⚠️ OPEN BY DESIGN, but now pinned (audit finding). `read: if
      // isSignedIn()` is REQUIRED: every public seller profile, the services
      // list and the admin panels read other users' documents directly, and
      // Firestore rules are all-or-nothing per document — there is no way to
      // open `name`/`avatar`/`role` to everyone and keep the rest closed.
      //
      // The audit of every client write to this collection (js/auth.js:
      // _ensureUserDoc / register / updateProfile / upgradeToSeller /
      // acceptTerms, plus functions/api/admin-migrate-private-fields.js) found
      // exactly ONE piece of personal data on this world-readable document:
      // `email`. Everything else is name / avatar / role / verified /
      // acceptedTerms / referredBy / timestamps — i.e. the intended public
      // profile. Phone, payout method and payout account already live in the
      // private subcollection below and are never accepted here.
      //
      // `create` therefore now pins the field set with hasOnly, so a client
      // cannot attach arbitrary extra data to a document that every registered
      // account can read. `update` was already allow-listed.
      allow read:   if isSignedIn();
      allow create: if isOwner(userId)
                    && (!('role' in request.resource.data) || request.resource.data.role in ['buyer','seller'])
                    && request.resource.data.keys().hasOnly([
                         'name','email','avatar','photoURL','displayName','bio',
                         'role','verified','emailVerified','acceptedTerms','termsAcceptedAt',
                         'referredBy','createdAt','updatedAt']);
      // ⚠️ CHANGED (privacy audit): 'phone' removed from the editable-fields
      // list. This document is readable by ANY signed-in user (needed so
      // buyers can see a seller's public name/avatar/bio/rating) — there is
      // no such thing as a "partial" Firestore rule that opens some fields
      // to everyone and others to nobody, security rules only ever see the
      // whole document. So anything that shouldn't be readable by every
      // other logged-in user (phone number; payoutMethod/payoutAccount were
      // already never in this list) now lives in the private subcollection
      // just below instead, not here. See js/auth.js (_ensureUserDoc,
      // register, updateProfile) and js/seller-dashboard.js
      // (savePayoutInfo) for the corresponding client-side change, and
      // functions/api/admin-migrate-private-fields.js for the one-time
      // migration of any pre-existing users' data out of this document.
      allow update: if isAdmin() || (
                      isOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['name','displayName','avatar','photoURL','bio',
                                  'role','updatedAt','acceptedTerms','termsAcceptedAt']) &&
                      (!('role' in request.resource.data.diff(resource.data).affectedKeys()) ||
                       (resource.data.role == 'buyer' && request.resource.data.role == 'seller'))
                    );
      allow delete: if isAdmin();

      // ── users/{uid}/private/{contact} ─────────────────────────────────────
      // ⚠️ ADDED: phone number + payout method/account — readable only by the
      // account owner and admins, never by "any signed-in user" the way the
      // parent document above is. A single fixed-id doc ('contact') rather
      // than one per field, since these are always read/written together.
      match /private/{docId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAdmin());
      }
    }

    // ── services ──────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      // FIXED: this create rule only required hasAll(...) — any EXTRA field the
      // seller chose to attach was accepted, and none of the trust/stats
      // fields were pinned. A seller could therefore publish a listing with
      // featured:true, rating:5, reviewCount:999, qualityScore:5 and
      // sellerVerified:true, and since none of those are in the update
      // allow-list either they could never be corrected afterwards. Enumerated
      // the exact field set js/services.js line 1165-1231 writes, pinned every
      // trust/stats field to its neutral starting value, and added hasOnly.
      allow create: if isSeller()
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.keys().hasAll(['title','price','sellerId','createdAt'])
                    && request.resource.data.keys().hasOnly([
                         'title','description','category','listingType','price','deliveryDays',
                         'revisions','recurring','image','tags','orderMode','updatedAt','createdAt',
                         'digitalDelivery','stockLimit','expiryDate','orderRules','images','structuredFields',
                         'sellerId','sellerName','sellerAvatar','sellerVerified',
                         'active','status','featured','rating','reviewCount','orderCount','ordersCount','views'])
                    && (!('sellerVerified' in request.resource.data) || request.resource.data.sellerVerified == false)
                    && (!('featured' in request.resource.data) || request.resource.data.featured == false)
                    && (!('rating' in request.resource.data) || request.resource.data.rating == 0)
                    && (!('reviewCount' in request.resource.data) || request.resource.data.reviewCount == 0)
                    && (!('orderCount' in request.resource.data) || request.resource.data.orderCount == 0)
                    && (!('ordersCount' in request.resource.data) || request.resource.data.ordersCount == 0)
                    && (!('views' in request.resource.data) || request.resource.data.views == 0)
                    && (!('qualityScore' in request.resource.data))
                    && (!('active' in request.resource.data) || request.resource.data.active == true)
                    && (!('status' in request.resource.data) || request.resource.data.status == 'active');
      // FIXED: the allow-list below was missing fields that js/services.js
      // ALWAYS sends on save (sellerId/sellerName/sellerAvatar/sellerVerified)
      // plus the product-only fields (orderRules/images/structuredFields) and
      // orderMode. Since security rules check the full diff, every single
      // seller edit was rejected with permission-denied. The seller-* fields
      // are re-derived from the caller's own profile and pinned to their
      // current values below, so allowing them here does not let a seller
      // impersonate another seller or self-award a "verified" badge.
      allow update: if isAdmin() || (
                      isSellerOwner(resource.data.sellerId) && isSeller() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['title','description','category','price','deliveryDays',
                                  'revisions','image','tags','active','status','recurring','updatedAt',
                                  'listingType','digitalDelivery','stockLimit','expiryDate',
                                  'orderMode','orderRules','images','structuredFields',
                                  'sellerId','sellerName','sellerAvatar','sellerVerified']) &&
                      (!('sellerId' in request.resource.data.diff(resource.data).affectedKeys()) ||
                        request.resource.data.sellerId == resource.data.sellerId) &&
                      (!('sellerName' in request.resource.data.diff(resource.data).affectedKeys()) ||
                        request.resource.data.sellerName == resource.data.sellerName) &&
                      (!('sellerAvatar' in request.resource.data.diff(resource.data).affectedKeys()) ||
                        request.resource.data.sellerAvatar == resource.data.sellerAvatar) &&
                      (!('sellerVerified' in request.resource.data.diff(resource.data).affectedKeys()) ||
                        request.resource.data.sellerVerified == resource.data.sellerVerified)
                    );
      // FIXED: add isSeller() to match update — a non-seller whose uid happens
      // to be sellerId of a listing could otherwise delete it.
      allow delete: if isAdmin() || (isSeller() && isSellerOwner(resource.data.sellerId));
    }

    // ── orders ────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      // Products skip approval (buyProductNow), and "instant" order-mode
      // services (openInstantModal → submitRequest) also start at 'accepted'
      // so payment can begin right away — everything else must start 'pending'.
      // ⚠️ SECURITY FIX (audit finding): price/sellerId used to be taken
      // straight from the client's write with no cross-check at all — a
      // buyer's own browser is what writes this document, so nothing stopped
      // it from naming a real service's serviceId while setting sellerId to
      // an account the buyer controls, or a price far from the service's
      // real one. The actual money was always safe (functions/api/payment.js
      // re-resolves both from the service doc itself before ever charging or
      // crediting anyone — see resolveExistingOrder()'s comments there for
      // the one path that had drifted from that and has since been fixed
      // too), but the order document itself — what the seller and the admin
      // panel display and reason about before payment — could still show a
      // spoofed seller/price. Requiring it to match the live service doc at
      // write time closes that gap at the source as well, not just at the
      // one endpoint that touches money.
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.paymentStatus == 'no_payment'
                    && (!('escrowHeld' in request.resource.data) || request.resource.data.escrowHeld != true)
                    && (
                         !('serviceId' in request.resource.data) ||
                         (
                           request.resource.data.sellerId == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.sellerId &&
                           request.resource.data.price    == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.price
                         )
                       )
                    && (
                         request.resource.data.status == 'pending'
                         || (request.resource.data.status == 'accepted' &&
                             (request.resource.data.listingType == 'product' ||
                              request.resource.data.orderMode == 'instant'))
                       );
      // ─────────────────────────────────────────────────────────────────────
      // Status transitions, bound to the party allowed to perform them.
      //
      // ⚠️ SECURITY FIX (critical audit finding): the update rule used to
      // admit ANY status value as long as the new status wasn't 'completed'
      // and the seller-owned escrow/payment fields were unchanged. The party
      // check was `buyer OR seller OR admin`, so the BUYER could set their
      // own order to 'accepted' — which is exactly the value both payment
      // gates check (js/payment-system.js line 98 and functions/api/payment.js
      // line 181) — and then pay real money into escrow for a service the
      // seller never agreed to. The same hole let a buyer cancel an accepted
      // order. This table is derived from the transitions the client actually
      // performs (grep of every `status:` write against COLLECTIONS.ORDERS):
      //
      //   seller: respondToRequest -> accepted|cancelled   (order-workspace 1870)
      //           sellerStartWork   -> in_progress         (order-workspace 1526)
      //           sellerDeliver     -> delivered           (order-workspace 1129, 1703)
      //   buyer:  requestRevision  -> revision            (order-workspace 1185)
      //           openDispute       -> disputed            (escrow 90, returns 213)
      //   buyer:  cancel before paying                    (anywhere)
      //
      // 'payment_held' and 'completed' are deliberately absent from the buyer
      // and seller rows: both are only ever written by the server's
      // service account (the Fawaterak webhook and the releaseEscrow handler),
      // which bypasses these rules entirely — so a client legitimately never
      // needs to set them here.
      // ─────────────────────────────────────────────────────────────────────
      function _sellerTransition() {
        let f = resource.data.status;
        let t = request.resource.data.status;
        return (f == 'pending'      && t in ['accepted','cancelled']) ||
               (f == 'accepted'     && t in ['cancelled','disputed']) ||
               (f == 'payment_held' && t in ['in_progress','cancelled','disputed']) ||
               (f == 'in_progress'  && t in ['delivered','revision','cancelled','disputed']) ||
               (f == 'revision'     && t in ['in_progress','delivered','cancelled','disputed']) ||
               (f == 'delivered'    && t in ['in_progress','disputed']);
      }
      function _buyerTransition() {
        let f = resource.data.status;
        let t = request.resource.data.status;
        return (f == 'pending'      && t == 'cancelled') ||
               (f == 'accepted'     && t == 'cancelled') ||
               (f in ['payment_held','in_progress'] && t == 'revision') ||
               (f in ['payment_held','in_progress','delivered'] && t == 'disputed');
      }

      allow update: if isAdmin() || (
                       isSignedIn() &&
                       (
                         // ── status-changing write: the mover must be the
                         //    party entitled to make that specific move.
                         (request.resource.data.status != resource.data.status
                            && (isSellerOwner(resource.data.sellerId) ? _sellerTransition()
                               : isOwner(resource.data.buyerId)     ? _buyerTransition()
                               : false))
                         ||
                         // ── status NOT changing: a plain aux-field write
                         //    (customStages, currentStageIndex,
                         //    shippingStatus, reviewed, updatedAt …) by
                         //    either party, subject to the pins below.
                         (request.resource.data.status == resource.data.status
                            && (isSellerOwner(resource.data.sellerId) || isOwner(resource.data.buyerId)))
                       ) &&
                       // 'delivered' is only reachable from active work
                       (request.resource.data.status != 'delivered' ||
                        resource.data.status in ['payment_held','in_progress','revision']) &&
                       // escrow + money fields are server-owned
                       (!('escrowHeld' in resource.data)   || request.resource.data.escrowHeld   == resource.data.escrowHeld) &&
                       (!('escrowAmount' in resource.data) || request.resource.data.escrowAmount == resource.data.escrowAmount) &&
                       (!('paymentId' in resource.data)    || request.resource.data.paymentId    == resource.data.paymentId) &&
                       (!('paymentStatus' in resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus) &&
                       // ⚠️ SECURITY FIX: 'reviewed' was completely unpinned,
                       // so a buyer could flip it back to false and submit a
                       // fresh review against the same completed order — an
                       // unbounded rating-forgery loop that also corrupted the
                       // seller quality score computed from these reviews
                       // (functions/api/quality-score.js averages all of them
                       // with no per-order dedup). It is now write-once: only
                       // a false -> true flip is ever allowed.
                       (!('reviewed' in resource.data) ||
                        (resource.data.reviewed != true && request.resource.data.reviewed == true)) &&
                       request.resource.data.price    == resource.data.price &&
                       request.resource.data.buyerId  == resource.data.buyerId &&
                       request.resource.data.sellerId == resource.data.sellerId
                     );
      allow delete: if isAdmin();
    }

    // ── payments ──────────────────────────────────────────────────────────────
    // ⚠️ CHANGED (audit finding): `create` used to be
    // `isSignedIn() && request.resource.data.userId == request.auth.uid`, i.e.
    // ANY signed-in user could create unlimited payment rows claiming to be
    // their own — which is why the admin "Payments" tab's Total In / Net
    // figures (js/dashboard.js sums this collection) could be poisoned at will
    // by any registered account, and why storage/quotacost was free to abuse.
    // The collection is now server-only: payment.js writes one row per
    // confirmed payment (with the service account, which bypasses these rules),
    // and no client write is legitimate. See the _recordPayment() note in
    // functions/api/payment.js for the other half of this fix — before it, the
    // collection was never written by anything, so this admin tab always showed
    // Total In = 0.
    match /payments/{paymentId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.userId ||
                        request.auth.uid == resource.data.sellerId || isAdmin());
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── wallets ───────────────────────────────────────────────────────────────
    match /wallets/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow write:  if isAdmin();
    }
    // ── transactions ──────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.userId || isAdmin());
      allow write:  if isAdmin();
    }
    // ── escrow ────────────────────────────────────────────────────────────────
    match /escrow/{orderId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      allow create: if false;
      allow update: if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId) &&
                       resource.data.status == 'held' &&
                       request.resource.data.status == 'frozen' &&
                       request.resource.data.amount   == resource.data.amount &&
                       request.resource.data.buyerId  == resource.data.buyerId &&
                       request.resource.data.sellerId == resource.data.sellerId
                    || isAdmin();
      allow delete: if isAdmin();
    }
    // ── withdrawals ───────────────────────────────────────────────────────────
    // ⚠️ SECURITY FIX (audit finding — critical): this used to allow ANY
    // signed-in user to create a withdrawals doc directly (only checking
    // `userId == auth.uid`), with no check on `amount` against their real
    // wallet balance at all. The real request flow (js/dashboard.js
    // submitWithdrawal → POST /api/payment `requestWithdrawal`) never uses
    // this client path — it goes entirely through functions/api/payment.js's
    // handleRequestWithdrawal, which verifies the balance server-side and
    // atomically debits the wallet using the service account (which bypasses
    // these rules by design, the same way escrow/wallets writes do). So a
    // client `create` here was never legitimate, only exploitable: someone
    // could hand-write a fake request for any amount with NO matching debit
    // ever having happened, have it sit in the admin's queue looking
    // identical to a real one, and if an admin clicked "✕ Reject" on it —
    // WalletManager.rejectWithdrawal() credits the wallet back by that exact
    // amount to undo a debit that, for a forged request, never occurred —
    // manufacturing real spendable balance out of nothing. Blocking client
    // `create` entirely closes this at the source; js/dashboard.js's
    // approve/reject actions were also hardened to check `status=='pending'`
    // first as defense in depth against double-processing.
    match /withdrawals/{reqId} {
      allow read:   if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ── reviews ───────────────────────────────────────────────────────────────
    // ⚠️ SECURITY FIX (audit finding): create used to only check
    // `reviewerId == auth.uid` — nothing tied the review to a real completed
    // order at all. Any signed-in user (a competitor, a seller reviewing
    // their own service from a second account, anyone) could post a review
    // for any seller/service with any rating, with no order ever having
    // happened — directly corrupting the rating shown to buyers and the
    // seller "quality score" functions/api/quality-score.js computes from
    // this same collection. Now a review can only be created by the actual
    // buyer of a real, COMPLETED order for that exact seller+service, and
    // only once per order (orders.reviewed flips to true in the same batch
    // that creates the review — see js/order-workspace.js submitReview —
    // so a second attempt sees reviewed==true and is rejected).
    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if isSignedIn()
                    && request.resource.data.reviewerId == request.auth.uid
                    && request.resource.data.orderId is string
                    && _order(request.resource.data.orderId).buyerId    == request.auth.uid
                    && _order(request.resource.data.orderId).sellerId   == request.resource.data.sellerId
                    && _order(request.resource.data.orderId).serviceId  == request.resource.data.serviceId
                    && _order(request.resource.data.orderId).status     == 'completed'
                    && _order(request.resource.data.orderId).reviewed   != true;
      allow update: if isAdmin() || (
                      isOwner(resource.data.reviewerId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','text','updatedAt']) &&
                      request.resource.data.sellerId  == resource.data.sellerId &&
                      request.resource.data.serviceId == resource.data.serviceId &&
                      request.resource.data.orderId   == resource.data.orderId
                    );
      allow delete: if isOwner(resource.data.reviewerId) || isAdmin();
    }

    // ── articles / blog_posts ─────────────────────────────────────────────────
    // ⚠️ CHANGED (audit finding): `allow write: if isAdmin()` also covered
    // update, which made the per-article view counter impossible: every
    // visitor's `update({views: increment(1)})` from js/blog-engine.js was
    // rejected with permission-denied and swallowed by its empty .catch(), so
    // the stored count of every article stayed at 0 forever. A public counter
    // is public information, so a single bounded increment is now allowed from
    // anyone — but ONLY a `views` change of exactly +1 and nothing else, which
    // keeps the document otherwise admin-only (a caller still cannot republish
    // an article, rewrite its content, or inflate the counter by more than 1).
    match /articles/{articleId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() || _isViewBump();
    }
    match /blog_posts/{postId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() || _isViewBump();
    }

    // ── analytics ─────────────────────────────────────────────────────────────
    // ⚠️ CLOSED (audit finding): nothing in js/ or functions/ reads or writes
    // this collection — the seller "Analytics" tab (js/seller-dashboard.js
    // renderAnalytics) computes its numbers from orders/escrow instead. So the
    // previous `read: if isSignedIn()` + `create: if isSignedIn()` was purely an
    // attack surface: any signed-in user could both read every analytics row
    // (whatever business figures end up there) and write unlimited garbage rows
    // at no cost. Made admin-only rather than deleted, so the collection can be
    // populated later through the admin panel / server without reopening the
    // write path to clients.
    match /analytics/{docId} {
      allow read:   if isAdmin();
      allow write:  if isAdmin();
    }

    // ── subscriptions ─────────────────────────────────────────────────────────
    match /subscriptions/{subId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      allow write:  if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // Per-type allow-list of every legitimate cross-user notification the app
    // actually creates client-side:
    //   'new_request'/'new_order'   buyer  -> seller  (request-system.js)
    //   'request_accepted'          seller -> buyer   (order-workspace.js)
    //   'payment_reminder'          seller -> buyer   (seller-dashboard.js)
    //   'delivery'                  seller -> buyer   (order-workspace.js)
    //   'buyer_instructions'        buyer  -> seller  (order-workspace.js)
    //   'stage_update'              seller -> buyer   (order-workspace.js)
    //   'dispute'                   buyer/seller -> 'ADMIN' (escrow.js)
    // Anything else (payment_confirmed, withdrawal_paid, etc.) requires
    // isAdmin(), i.e. only the server's service-account writes.
    match /notifications/{notifId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() && request.resource.data.orderId is string && (
          ((request.resource.data.type == 'new_request' || request.resource.data.type == 'new_order') &&
           request.auth.uid == _order(request.resource.data.orderId).buyerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).sellerId) ||
          ((request.resource.data.type == 'request_accepted' || request.resource.data.type == 'payment_reminder' ||
            request.resource.data.type == 'delivery' || request.resource.data.type == 'stage_update' ||
            // FIXED: 'shipping' (markProductShipped in js/order-workspace.js) was
            // never listed here, so every product-shipment notification was
            // rejected by security rules. The seller updates the order doc
            // first and writes the notification after, so the failure left the
            // order marked shipped with the buyer never told.
            request.resource.data.type == 'shipping') &&
           request.auth.uid == _order(request.resource.data.orderId).sellerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).buyerId) ||
          (request.resource.data.type == 'buyer_instructions' &&
           request.auth.uid == _order(request.resource.data.orderId).buyerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).sellerId) ||
          ((request.resource.data.type == 'dispute' || request.resource.data.type == 'return_manual_refund' || request.resource.data.type == 'user_report') &&
           request.resource.data.userId == 'ADMIN' &&
           (request.auth.uid == _order(request.resource.data.orderId).buyerId ||
            request.auth.uid == _order(request.resource.data.orderId).sellerId)) ||
          // ── Product returns (js/returns.js) ─────────────────────────────
          (request.resource.data.type == 'return_requested' &&
           request.auth.uid == _order(request.resource.data.orderId).buyerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).sellerId) ||
          ((request.resource.data.type == 'return_approved' || request.resource.data.type == 'return_rejected') &&
           request.auth.uid == _order(request.resource.data.orderId).sellerId &&
           request.resource.data.userId == _order(request.resource.data.orderId).buyerId)
        )
      );
      // FIXED: the owner could previously rewrite ANY field of their own
      // notification — including userId, which re-targets the row into another
      // account's list, along with type/title/message to inject arbitrary
      // content. The only legitimate client update is marking it read
      // (js/notifications.js line 99), so restrict the diff to that.
      allow update: if isAdmin() || (
                      isOwner(resource.data.userId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['read','readAt','archived'])
                    );
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── chats / messages (legacy Firestore — real chat lives in RTDB now) ────
    match /chats/{chatId} {
      allow read, write: if isSignedIn() &&
                            (request.auth.uid in resource.data.participants || isAdmin());
      match /messages/{msgId} {
        allow read, write: if false;
      }
    }
    match /messages/{msgId} {
      allow read, write: if false;
    }

    // ── coupons ───────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── disputes ──────────────────────────────────────────────────────────────
    // ⚠️ SECURITY FIX (audit finding): create used to be
    // `isSignedIn() && (newData.buyerId == auth.uid || newData.sellerId == auth.uid)`
    // — which reads like it proves the caller is a party to the dispute, but it
    // only proves they typed their OWN uid into one of the two fields. They
    // could set the other field to any victim and `orderId` to anything at all
    // (or omit it entirely), producing a dispute row that reads as genuine,
    // shows up in the admin panel's open-disputes queue (js/dashboard.js) and
    // in admin-dispute-detail, and blocks the escrow-resolution path with its
    // 409 guard. The dispute document is also what functions/api/payment.js's
    // handleResolveDispute() acts on. Now the whole document is bound to a real
    // order and to the caller's actual role in it.
    match /disputes/{disputeId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId  ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      allow create: if isSignedIn()
                       && request.resource.data.orderId is string
                       && request.resource.data.buyerId  == _order(request.resource.data.orderId).buyerId
                       && request.resource.data.sellerId == _order(request.resource.data.orderId).sellerId
                       && request.auth.uid in [_order(request.resource.data.orderId).buyerId,
                                               _order(request.resource.data.orderId).sellerId]
                       && request.resource.data.raisedBy == request.auth.uid
                       // A dispute may only be raised against an order that has
                       // money in it — otherwise there is nothing to dispute.
                       && _order(request.resource.data.orderId).status in ['payment_held','in_progress','delivered','revision']
                       && request.resource.data.status == 'open'
                       && request.resource.data.keys().hasAll(['orderId','buyerId','sellerId','raisedBy','reason','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── returns (product-return requests: buyer → seller → admin refund) ───────
    // Mirrors the /disputes pattern above: buyer creates, only the seller on
    // that order (or admin) can move it forward, and only while it's still
    // 'pending' (a decided return can't be flipped back by the seller).
    //
    // ⚠️ SECURITY FIX (audit finding): create only ever compared the client's
    // own `buyerId` to the caller's uid. `sellerId`, `price`, `serviceTitle`
    // and `orderStatusAtRequest` were entirely client-supplied and never
    // checked against anything, so a buyer could file a return against ANY
    // order id — at any time, including an order that was never delivered —
    // while naming an arbitrary `sellerId`. That matters well beyond this
    // collection: js/returns.js copies ret.buyerId / ret.sellerId verbatim into
    // the dispute document it creates when the seller approves, and an admin
    // then resolves that dispute against real escrow in
    // functions/api/payment.js. Every identity-bearing field is now bound to
    // the live order document.
    match /returns/{returnId} {
      allow read:   if isSignedIn() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId ||
                        isAdmin());
      allow create: if isSignedIn()
                       && request.resource.data.orderId is string
                       && request.resource.data.buyerId  == _order(request.resource.data.orderId).buyerId
                       && request.resource.data.sellerId == _order(request.resource.data.orderId).sellerId
                       && request.resource.data.buyerId  == request.auth.uid
                       && request.resource.data.status   == 'pending'
                       && request.resource.data.keys().hasAll(['orderId','buyerId','sellerId','reasonCode','status','createdAt'])
                       // A return only makes sense against a paid, delivered
                       // order — otherwise there is nothing to send back.
                       && _order(request.resource.data.orderId).status == 'delivered';
      allow update: if isAdmin() || (
                       isSignedIn() &&
                       request.auth.uid == resource.data.sellerId &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status in ['approved','rejected'] &&
                       request.resource.data.orderId  == resource.data.orderId &&
                       request.resource.data.buyerId  == resource.data.buyerId &&
                       request.resource.data.sellerId == resource.data.sellerId
                     );
      allow delete: if isAdmin();
    }

    // ── service_views counter ─────────────────────────────────────────────────
    // ⚠️ SECURITY FIX (audit finding): `create: if true` let literally
    // anyone — including a signed-out visitor — write unlimited documents
    // here for free, with no shape or rate check at all: a pure storage/
    // quota-abuse (denial-of-wallet) vector. Grepping the whole app, nothing
    // in js/ or functions/ actually reads or writes this collection any
    // more (it appears to be leftover from a view-counter feature that was
    // never wired up, or was removed) — closing it to admin-only rather
    // than trying to validate a shape nothing currently produces.
    match /service_views/{viewId} {
      allow read, write: if isAdmin();
    }

    // ── categories ────────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
    }

    // ── fraud_flags ───────────────────────────────────────────────────────────
    // ⚠️ PARTIALLY FIXED — please read (audit finding, still open by design):
    // the auto-flagging helper flagSuspiciousContent() in js/constants.js writes
    // here whenever the contact-leak scanner trips (phone number / email /
    // "DM me on…" in a listing, a request brief, a product order's notes, or a
    // chat message). But NOTHING IN THE PROJECT EVER READS THIS COLLECTION —
    // not the admin panel, not any Cloudflare Function. So the automatic
    // anti-fraud reporting feature is currently a no-op: it burns a write per
    // detection and the flags are invisible to operators. Wiring an admin UI
    // (or an alert) for this collection is a product decision, not a security
    // fix, so it was left alone rather than guessed at.
    //
    // What WAS fixed here: `create` accepted any field set, so a user could
    // attach unbounded junk (and try to spoof `textSample`/`userId` values for
    // someone else) at no cost. The shape is now pinned to exactly what
    // flagSuspiciousContent() sends, with the sample length bounded.
    match /fraud_flags/{flagId} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if isSignedIn()
                       && request.resource.data.userId == request.auth.uid
                       && request.resource.data.kind is string
                       && request.resource.data.textSample is string
                       && request.resource.data.textSample.size() <= 200
                       && request.resource.data.keys().hasAll(['userId','kind','textSample','createdAt'])
                       && request.resource.data.keys().hasOnly(
                            ['userId','kind','textSample','createdAt','source','orderId','serviceId','listingId']);
    }

    // ── settings ──────────────────────────────────────────────────────────────
    // ⚠️ FIXED (found in audit): read used to require isSignedIn(), but
    // loadPlatformSettings() in constants.js runs at app start BEFORE
    // Firebase Auth has resolved (even for a logged-in user auth.uid can
    // still be null at that exact moment — a timing race, not a real
    // permission problem), and guests browsing services before logging in
    // also need the real commission % to see accurate pricing. This
    // document only holds public config (fee %, feature toggles) — never
    // secrets — so making it world-readable is safe; only admins can still
    // write it.
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── pending_payments (server-only) ───────────────────────────────────────
    match /pending_payments/{id} {
      allow read, write: if false;
    }

    // ── rate_limits (server-only) ─────────────────────────────────────────────
    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // ── admin_actions (audit log — server-write only via admin-delete.js) ───
    match /admin_actions/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
