{
  "name": "mall-services-v3",
  "version": "3.0.0",
  "description": "Mall Services - Professional Services Marketplace Platform",
  "private": true,
  "scripts": {
    "dev":   "npx live-server --port=3000 --open=/index.html",
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.css --minify",
    "build": "npm run build:css",
    "watch:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.css --watch",
    "deploy": "npm run build:css && npx wrangler pages deploy . --project-name=mall-services"
  },
  "dependencies": {
    "axios": "^1.6.7"
  },
  "devDependencies": {
    "wrangler": "^3.90.0",
    "tailwindcss": "^3.4.13"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
